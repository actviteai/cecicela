    "url": "https://actvite.com"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/actviteai/cecicela#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actviteai/cecicela.git",
    "directory": "packages/cecicela"
  },
  "bugs": {
    "url": "https://github.com/actviteai/cecicela/issues"
  },
  "keywords": [
    "cecicela",
    "ceci",
    "cela",
    "trouble",
    "agent-skills",
