    "mlops",
    "model-evaluation",
    "xgboost",
    "gpu-scheduling"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "lib",
    "skill",
    "!**/*.test.js",
    "!**/__pycache__",
    "!**/*.py[cod]"
  ]
}
